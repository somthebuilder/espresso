# ── Auth (optional) ──
# Omit or set to false so users can use the app without sign-in (default).
# NEXT_PUBLIC_AUTH_REQUIRED=true

# ── Supabase (required) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Server-side Supabase key (for API routes) ──
# Required for Operator Simulator (simulation_runs inserts bypass RLS). Use the
# service role key from Supabase → Project Settings → API (never expose in client code).

# ── AI Keys (server-side: chat, simulator complete) ──
# Prefer this file (frontend/.env.local). You can also set the same vars in repo-root .env
# (loaded by next.config.js). GOOGLE_API_KEY is accepted as an alias for Gemini.
GEMINI_API_KEY=your-gemini-key
# GOOGLE_API_KEY=your-google-ai-key
# OPENAI_API_KEY=...  # optional fallback for embeddings (simulator citations, chat)
# OPENAI_API_KEY=your-openai-key
